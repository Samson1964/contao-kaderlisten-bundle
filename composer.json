{
    "name": "schachbulle/contao-kaderlisten-bundle",
    "type": "contao-bundle",
    "description": "Verwaltet Kaderlisten von Schachspielern und gibt sie im Frontend aus.",
    "keywords": [
        "contao",
        "schach",
        "kader",
        "spieler",
        "liste"
    ],
    "homepage": "https://github.com/Samson1964/contao-kaderlisten-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Binding",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^4.13 || ^5.0",
        "schachbulle/contao-spielerregister-bundle": "*"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoKaderlistenBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoKaderlistenBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-kaderlisten-bundle/issues",
        "source": "https://github.com/Samson1964/contao-kaderlisten-bundle"
    }
}
